# API origin used directly by the browser. Defaults to the live backend:
#   https://housecheck-nessa.fly.dev
# Override only for local backend development, e.g.:
# VITE_API_URL=http://localhost:8080
#
# Alternative: keep the app on the default live URL but point the Vite dev
# proxy elsewhere (only used when VITE_API_URL is set to a relative /api path):
# VITE_BACKEND_URL=http://localhost:8080
